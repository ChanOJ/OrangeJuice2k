.DS_Store

# Secrets safety net (secrets never live in files)
.env
.env.*
*.env
# Proton Pass references only (no secret value)
!infra/secrets.env
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.tfvars
*.tfvars.json

# Private raw material: original ASP sources (credentials), SQL Server database
# (e-mails, passwords, IPs), private pictures, research notes. Never published.
private/

# site/ (the generated static site, about 300 MB) is committed: built on the Mac from private/
# (scripts/publish.sh), deployed by CI when merged to main.

# OpenTofu
.terraform/
*.tfstate
# The state is encrypted (infra/encryption.tf, enforced) and shared through git.
!infra/terraform.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Generated or local working files (tmp/ also holds the deploy checks stamp)
build/
dist/
tmp/
__pycache__/
*.sqlite
*.db

# Personal Claude Code settings
.claude/settings.local.json
